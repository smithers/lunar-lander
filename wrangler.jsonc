{
  // Cloudflare Workers static-assets deploy: serves the Vite build in ./dist.
  // No Worker script is needed, and static asset requests are free on the Workers Free plan.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunar-lander",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist"
  }
}
